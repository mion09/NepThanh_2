{
  "builds": [
    { "src": "app.py", "use": "@vercel/python" },
    { "src": "static/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/static/(.*)", "dest": "/static/$1" },
    { "src": "/favicon.ico", "dest": "/static/favicon.ico" },
    { "src": "/robots.txt", "dest": "/static/robots.txt" },
    { "src": "/api/(blog|demo|generate)(/.*)?", "status": 404 },
    { "src": "/blog/[0-9]+", "status": 404 },
    { "src": "/home", "status": 404 },
    { "src": "/(wp-admin|wp-login|wordpress|wp-content|xmlrpc\\.php)(/.*)?", "status": 404 },
    { "src": "/.*\\.php", "status": 404 },
    { "src": "/\\.git(/.*)?", "status": 404 },
    { "src": "/(.*)", "dest": "app.py" }
  ],
  "headers": [
    {
      "source": "/static/(.*)\\.(jpg|jpeg|png|webp|gif|svg|ico|mp4|webm|glb|gltf)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/static/(.*)\\.(css|js)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=86400" }
      ]
    }
  ]
}
